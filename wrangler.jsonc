{
  // Static site served by Workers static assets. Name must match the Worker in the Cloudflare dashboard.
  // Without this file, `wrangler deploy` auto-configures the project in CI (installs the Astro
  // Cloudflare adapter and runs a second build), which also defeats the incremental build cache.
  "name": "pv-workbench-astro",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
