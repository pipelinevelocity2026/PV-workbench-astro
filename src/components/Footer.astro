
---
const {settings} = Astro.props
---

<footer class="site-footer">
  <div class="container">

    <h2>{settings?.logoText || settings?.siteTitle || 'TENDER.'}</h2>

    <p>{settings?.footerText}</p>

    <p class="copyright">
      {settings?.copyright || '© 2026 All rights reserved.'}
    </p>

  </div>
</footer>
