---
interface NavItem {
  label: string
  url: string
}

interface Settings {
  siteTitle?: string
  logoText?: string
  navigation?: NavItem[]
  headerButtonText?: string
  headerButtonUrl?: string
}

interface Props {
  settings?: Settings | null
}

const {settings} = Astro.props

// Menu comes from Sanity (Site Settings > Header Navigation). If the editor has
// not added a Blog item yet, append one so the blog is always reachable.
// Adding any item pointing at /blog in Sanity takes over (no duplicate).
const navigation = settings?.navigation ?? []
const hasBlogLink = navigation.some((item) => /^\/blog\/?$/.test(item.url?.trim() ?? ''))
const items = hasBlogLink ? navigation : [...navigation, {label: 'Blog', url: '/blog/'}]
---

<header class="site-header">
  <div class="container header-inner">

    <a href="/" class="logo">
      {settings?.logoText || settings?.siteTitle || 'TENDER.'}
    </a>

    <nav>
      {items.map((item) => (
        <a href={item.url}>{item.label}</a>
      ))}
    </nav>

    {settings?.headerButtonText && (
      <a
        href={settings.headerButtonUrl || '/contact'}
        class="header-btn"
      >
        {settings.headerButtonText}
      </a>
    )}

  </div>
</header>
