---
/** Renders /blog/ (page 1) and /blog/page/N/ (N >= 2). */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from './Breadcrumbs.astro'
import CategoryNav from './CategoryNav.astro'
import FeaturedPost from './FeaturedPost.astro'
import PostGrid from './PostGrid.astro'
import Pagination from './Pagination.astro'
import Newsletter from './Newsletter.astro'
import {loadBlogIndex} from '../../lib/blog'
import {getSiteSettings} from '../../lib/queries'
import {buildTitle} from '../../lib/seo'
import {paths} from '../../lib/urls'

interface Props {
  page: number
  /** Preloaded by getStaticPaths so the page's cacheKey hashes exactly what is rendered. */
  data?: Awaited<ReturnType<typeof loadBlogIndex>>
}
const {page, data} = Astro.props
const {settings, hero, picks, posts, totalPages, categories} = data ?? (await loadBlogIndex(page))
const site = await getSiteSettings()

const heading = settings.title || 'Blog'
const description = settings.seo?.metaDescription || settings.description || undefined
const first = page === 1
const crumbs = [
  {name: 'Home', path: '/'},
  {name: 'Blog', path: paths.blog()},
  ...(first ? [] : [{name: `Page ${page}`}]),
]
---

<BaseLayout
  seo={{
    title: buildTitle({seo: settings.seo, fallback: heading, siteName: site?.siteTitle, page}),
    description,
    path: paths.blogPage(page),
    noindex: Boolean(settings.seo?.noIndex),
    canonicalOverride: first ? settings.seo?.canonicalUrl : null,
  }}
>
  <div class="container wrap">
    <Breadcrumbs items={crumbs} />

    <header class:list={['hero', {compact: !first}]}>
      <h1>{heading}{!first && <span class="pg"> – Page {page}</span>}</h1>
      {first && settings.description && <p>{settings.description}</p>}
    </header>

    <CategoryNav categories={categories} />

    {first && hero && (
      <section class="block" aria-label="Featured article">
        <FeaturedPost post={hero} />
      </section>
    )}

    {/* With a hero and nothing else yet, skip the empty grid. */}
    {(posts.length > 0 || !hero) && (
    <section class="block" aria-labelledby="latest-heading">
      <h2 id="latest-heading">{first ? 'Latest articles' : 'Articles'}</h2>
      <PostGrid posts={posts} priorityCount={first && hero ? 0 : 3} />
      <div class="pager">
        <Pagination current={page} total={totalPages} href={paths.blogPage} />
      </div>
    </section>
    )}

    {first && picks.length > 0 && (
      <section class="block" aria-labelledby="picks-heading">
        <h2 id="picks-heading">Editor's picks</h2>
        <PostGrid posts={picks} />
      </section>
    )}

    {first && settings.newsletterEnabled && (
      <div class="block">
        <Newsletter heading={settings.newsletterHeading} action={settings.newsletterFormUrl} />
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .wrap {
    padding: 1.5rem 0 4rem;
  }
  .hero {
    padding: 2.5rem 0 1.5rem;
  }
  .hero.compact {
    padding: 1.5rem 0 1rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
  }
  .pg {
    color: var(--color-muted);
    font-weight: 500;
  }
  .hero p {
    margin: 0.75rem 0 0;
    max-width: 60ch;
    font-size: 1.15rem;
    color: var(--color-muted);
  }
  .block {
    margin-top: 3rem;
  }
  h2 {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
  }
  .pager {
    margin-top: 2.5rem;
  }
</style>
