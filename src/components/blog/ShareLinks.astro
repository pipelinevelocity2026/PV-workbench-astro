---
/** Plain links (no third-party scripts, no JS). */
interface Props {
  url: string
  title: string
}
const {url, title} = Astro.props
const u = encodeURIComponent(url)
const t = encodeURIComponent(title)
const links = [
  {name: 'X', href: `https://twitter.com/intent/tweet?url=${u}&text=${t}`},
  {name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`},
  {name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`},
  {name: 'Email', href: `mailto:?subject=${t}&body=${u}`},
]
---

<section class="share" aria-labelledby="share-heading">
  <h2 id="share-heading">Share this article</h2>
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href} target="_blank" rel="noopener noreferrer">
          {l.name}<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  h2 {
    font-size: 1rem;
    margin: 0 0 0.6rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.9rem;
  }
  a:hover {
    border-color: var(--color-accent);
  }
</style>
