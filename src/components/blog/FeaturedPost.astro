---
import SanityImage from './SanityImage.astro'
import PostMeta from './PostMeta.astro'
import {paths} from '../../lib/urls'
import type {PostCard} from '../../lib/types'

interface Props {
  post: PostCard
}
const {post} = Astro.props
---

<article class="featured">
  {post.featuredImage && (
    <a href={paths.post(post.slug)} tabindex="-1" aria-hidden="true" class="media">
      <SanityImage
        image={post.featuredImage}
        aspect={16 / 10}
        widths={[480, 640, 800, 1200]}
        sizes="(min-width: 900px) 560px, 100vw"
        priority
      />
    </a>
  )}
  <div class="text">
    <p class="label">Featured</p>
    <h2><a href={paths.post(post.slug)}>{post.title}</a></h2>
    <p class="excerpt">{post.excerpt}</p>
    <PostMeta publishedAt={post.publishedAt} author={post.author} />
    <a class="primary-btn" href={paths.post(post.slug)}>
      Read article<span class="visually-hidden">: {post.title}</span>
    </a>
  </div>
</article>

<style>
  .featured {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .featured {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .media {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
  }
  h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    line-height: 1.2;
  }
  h2 a:hover {
    text-decoration: underline;
  }
  .excerpt {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.05rem;
  }
</style>
