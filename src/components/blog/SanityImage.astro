---
/** Responsive CDN image. Always renders width/height to reserve space (no CLS). */
import {imageSrcset, imageUrl} from '../../lib/image'
import type {SanityImageData} from '../../lib/types'

interface Props {
  image: SanityImageData
  /** Fallback alt when the image has none. Pass "" for decorative images. */
  alt?: string
  widths?: number[]
  sizes: string
  /** Crop to this width/height ratio, e.g. 16/9. */
  aspect?: number
  /** true only for the above-the-fold (LCP) image. */
  priority?: boolean
  class?: string
}

const {image, alt, widths = [320, 480, 640, 800, 1200], sizes, aspect, priority = false, class: className} = Astro.props
// Fallback src: the middle width (browsers that support srcset ignore it).
const baseWidth = Math.min(widths[Math.floor(widths.length / 2)], image.width)
const ratio = aspect ?? image.width / image.height
const displayWidth = Math.min(widths[widths.length - 1], image.width)
---

<img
  src={imageUrl(image.url, baseWidth, aspect ? Math.round(baseWidth / ratio) : undefined)}
  srcset={imageSrcset(image, widths, aspect)}
  sizes={sizes}
  alt={image.alt ?? alt ?? ''}
  width={displayWidth}
  height={Math.round(displayWidth / ratio)}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  class={className}
/>
