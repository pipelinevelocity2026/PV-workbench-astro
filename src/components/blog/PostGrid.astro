---
import BlogCard from './BlogCard.astro'
import type {PostCard} from '../../lib/types'

interface Props {
  posts: PostCard[]
  headingLevel?: 2 | 3
  emptyMessage?: string
  /** Eager-load the first N images (above the fold on desktop). */
  priorityCount?: number
}
const {posts, headingLevel = 3, emptyMessage = 'No articles yet. Check back soon.', priorityCount = 0} = Astro.props
---

{posts.length === 0 ? (
  <p class="empty">{emptyMessage}</p>
) : (
  <ul class="grid">
    {posts.map((post, i) => (
      <li>
        <BlogCard post={post} headingLevel={headingLevel} priority={i < priorityCount} />
      </li>
    ))}
  </ul>
)}

<style>
  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--color-muted);
    background: var(--color-surface);
    border-radius: var(--radius);
  }
</style>
