---
import {sanity} from '../lib/sanity'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface NavItem {
  label: string
  url: string
}

interface SiteSettings {
  siteTitle?: string
  logoText?: string
  navigation?: NavItem[]
  headerButtonText?: string
  headerButtonUrl?: string
  [key: string]: unknown
}

interface HomeSection {
  eyebrow?: string
  heading?: string
  subheading?: string
  paragraph?: string
  buttonText?: string
  buttonUrl?: string
}

interface HomePage {
  heroEyebrow?: string
  heroHeading?: string
  heroDescription?: string
  heroButtonText?: string
  heroButtonUrl?: string
  sections?: HomeSection[]
}

const settingsQuery = `*[_type == "siteSettings"][0]`

const homeQuery = `*[_type == "homePage"][0]`

const [settings, home] = await Promise.all([
  sanity.fetch<SiteSettings | null>(settingsQuery),
  sanity.fetch<HomePage | null>(homeQuery),
])
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={home?.heroDescription || 'Welcome to our website.'}
    />
    <title>
      {home?.heroHeading || settings?.siteTitle || 'Home'}
    </title>
  </head>

  <body>

    <Header settings={settings} />

    <main>

      <!-- HERO SECTION -->
      <section class="hero">
        <div class="container">

          <span class="eyebrow">
            {home?.heroEyebrow}
          </span>

          <h1>
            {home?.heroHeading || 'Welcome to our website'}
          </h1>

          <p>
            {home?.heroDescription}
          </p>

          {home?.heroButtonText && (
            <a
              href={home.heroButtonUrl || '/contact'}
              class="primary-btn"
            >
              {home.heroButtonText}
            </a>
          )}

        </div>
      </section>

      <!-- DYNAMIC CONTENT SECTIONS -->
      {home?.sections?.map((section) => (
        <section class="content-section">
          <div class="container">

            {section.eyebrow && (
              <span class="eyebrow">
                {section.eyebrow}
              </span>
            )}

            {section.heading && (
              <h2>{section.heading}</h2>
            )}

            {section.subheading && (
              <h3>{section.subheading}</h3>
            )}

            {section.paragraph && (
              <p>{section.paragraph}</p>
            )}

            {section.buttonText && (
              <a
                href={section.buttonUrl || '/contact'}
                class="primary-btn"
              >
                {section.buttonText}
              </a>
            )}

          </div>
        </section>
      ))}

    </main>

    <Footer settings={settings} />

  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
    color: #17243b;
  }

  a {
    text-decoration: none;
  }

  .container {
    width: min(1120px, 90%);
    margin: auto;
  }

  .site-header {
    background: #101c32;
    color: white;
    padding: 22px 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    color: white;
    font-size: 24px;
    font-weight: 800;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: white;
    font-size: 14px;
  }

  .header-btn,
  .primary-btn {
    display: inline-block;
    background: #2563eb;
    color: white;
    padding: 13px 22px;
    border-radius: 6px;
  }

  .hero {
    background: #101c32;
    color: white;
    padding: 110px 0;
  }

  .hero h1 {
    max-width: 850px;
    font-size: clamp(38px, 6vw, 68px);
    line-height: 1.1;
    margin: 20px 0;
  }

  .hero p {
    max-width: 650px;
    color: #cbd5e1;
    font-size: 18px;
    line-height: 1.8;
    margin-bottom: 30px;
  }

  .eyebrow {
    color: #60a5fa;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 12px;
  }

  .content-section {
    padding: 85px 0;
  }

  .content-section:nth-child(even) {
    background: #f1f5f9;
  }

  .content-section h2 {
    font-size: clamp(30px, 4vw, 44px);
    max-width: 800px;
  }

  .content-section h3 {
    font-size: 22px;
  }

  .content-section p {
    max-width: 750px;
    color: #64748b;
    font-size: 17px;
    line-height: 1.8;
  }

  .site-footer {
    background: #101c32;
    color: white;
    padding: 55px 0;
  }

  .site-footer p {
    color: #cbd5e1;
  }

  .copyright {
    margin-top: 35px;
    font-size: 13px;
  }

  @media (max-width: 700px) {
    .header-inner {
      flex-wrap: wrap;
    }

    nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 12px;
    }

    .header-btn {
      font-size: 13px;
      padding: 10px 14px;
    }

    .hero {
      padding: 75px 0;
    }
  }
</style>
