---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<!-- Cloudflare serves /404.html with an HTTP 404 for any unknown URL, including
     deleted/unpublished posts and old slugs without a redirect. -->
<BaseLayout seo={{title: 'Page not found', path: '/404/', noindex: true}}>
  <div class="container" style="padding: 4rem 0">
    <h1>Page not found</h1>
    <p>The page you are looking for does not exist or has moved.</p>
    <p><a href="/blog/">Browse the blog</a></p>
  </div>
</BaseLayout>
