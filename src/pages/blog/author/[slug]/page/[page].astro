---
import ArchiveView from '../../../../../components/blog/ArchiveView.astro'
import {archivePaths, loadAuthorArchive} from '../../../../../lib/blog'
import {contentKey} from '../../../../../lib/cache-keys'

export async function getStaticPaths() {
  const all = await archivePaths('author')
  return Promise.all(
    all
      .filter((p) => p.page >= 2)
      .map(async ({slug, page}) => {
        const data = await loadAuthorArchive(slug, page)
        return {params: {slug, page: String(page)}, props: {data}, cacheKey: await contentKey(data)}
      }),
  )
}

const page = Number(Astro.params.page)
const {data} = Astro.props
if (!data) throw new Error(`Author "${Astro.params.slug}" not found`)
---

<ArchiveView kind="author" page={page} {...data} />
