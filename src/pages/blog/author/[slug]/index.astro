---
import ArchiveView from '../../../../components/blog/ArchiveView.astro'
import {archivePaths, loadAuthorArchive} from '../../../../lib/blog'
import {contentKey} from '../../../../lib/cache-keys'

export async function getStaticPaths() {
  const all = await archivePaths('author')
  return Promise.all(
    all
      .filter((p) => p.page === 1)
      .map(async ({slug}) => {
        const data = await loadAuthorArchive(slug, 1)
        return {params: {slug}, props: {data}, cacheKey: await contentKey(data)}
      }),
  )
}

const {data} = Astro.props
if (!data) throw new Error(`Author "${Astro.params.slug}" not found`)
---

<ArchiveView kind="author" page={1} {...data} />
