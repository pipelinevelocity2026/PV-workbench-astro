# Copy this file to .env for local development (.env is git-ignored):
#   cp .env.example .env
# On Cloudflare set the same names under Settings > Variables and Secrets.

# ======================================================================
# PUBLIC - safe to commit. These identify the project and only allow
# reading published content. They are visible in any browser network tab.
# ======================================================================

# Production origin (no trailing slash). Canonicals, sitemap and JSON-LD use it.
SITE_URL=https://pv-workbench-astro.pratik-d8a.workers.dev

SANITY_PROJECT_ID=0huhxxkr
SANITY_DATASET=production

# ======================================================================
# PRIVATE - NEVER commit real values, never prefix with PUBLIC_.
# Used from Phase 5 (draft preview / webhook). On Cloudflare create them
# as *Secrets*, not plain variables.
# ======================================================================

# Viewer-role token, server-side preview route only.
SANITY_API_READ_TOKEN=
# Shared secret that protects the /preview route.
PREVIEW_SECRET=
# Secret used to verify Sanity webhook signatures.
SANITY_WEBHOOK_SECRET=
